{
  "manifest_version": 3,
  "name": "Stash",
  "version": "1.0.0",
  "action": { "default_popup": "index.html" },
  "background": {
    "service_worker": "src/background.ts", 
    "type": "module" 
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["src/content.ts"],
      "run_at": "document_end"
    }
  ],
  "permissions": ["storage", "activeTab"],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "http://127.0.0.1:8080/*",
      "http://localhost:8080/*"
    ]
  }
}
